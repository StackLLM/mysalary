# Réglages de docker-compose.yml. Copier ce fichier en `.env` à la racine du dépôt (ignoré par git).
# Tout est facultatif en local.

# Port de l'interface sur ta machine (127.0.0.1 uniquement).
# PORT_WEB=8080

# Adresse où tu ouvres l'interface : elle sert aux liens des e-mails et au cookie.
# APP_URL=http://127.0.0.1:8080

# development (par défaut) : liens d'e-mail écrits dans le journal (docker compose logs api).
# production : exige APP_URL en https://, SMTP_URL et MAIL_CONTACT (docs/prod.md § 8.1) ; le serveur refuse de démarrer sinon.
# NODE_ENV=production
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.com:465
# MAIL_FROM="MySalary <no-reply@exemple.com>"
# MAIL_CONTACT=contact@exemple.com
