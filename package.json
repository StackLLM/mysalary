{
  "name": "mysalary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/partage",
    "packages/moteur",
    "server",
    "ui"
  ],
  "scripts": {
    "dev": "concurrently -n server,ui -c auto \"npm run dev -w server\" \"npm run dev -w ui\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verifier": "npm run typecheck && npm run test && npm run build",
    "db:migrer": "npm run db:migrer -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
