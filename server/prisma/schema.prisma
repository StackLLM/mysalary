// MySalary — schéma de données (produit.md (Plan) § 6).
// Montants en centimes (Int). Chaque table métier porte utilisateurId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id                String    @id @default(cuid())
  prenom            String
  /// Identifiant de connexion (lot 23), en minuscules. Vide pour un compte d'avant le lot 23, jusqu'à son activation.
  email             String?   @unique
  /// Date où le propriétaire a ouvert le lien reçu à cette adresse (lot 24). Vide = adresse non vérifiée.
  emailVerifieLe    DateTime?
  devise            String    @default("MAD")
  onboardingEtape   Int       @default(0)
  onboardingTermine Boolean   @default(false)
  /// Hash scrypt du mot de passe ; vide = compte d'avant le lot 23, qui ne peut pas se connecter avant son activation.
  motDePasse        String?
  derniereOuverture DateTime?
  creeLe            DateTime  @default(now())
  modifieLe         DateTime  @updatedAt
  reglages          Reglages?
  contrats          ContratSalaire[]
  paies             Paie[]
  sources           SourceRevenu[]
  revenusRecus      RevenuRecu[]
  categories        Categorie[]
  charges           Charge[]
  ponctuels         Ponctuel[]
  dettes            Dette[]
  depenses          Depense[]
  clotures          ClotureMois[]
  journalClotures   JournalCloture[]
  comptesEpargne    CompteEpargne[]
  mouvementsEpargne MouvementEpargne[]
  objectifs         Objectif[]
  scenarios         Scenario[]
  importSource      ImportSource?
  sessions          Session[]
  jetons            JetonMotDePasse[]
  jetonsEmail       JetonEmail[]
}

model Reglages {
  id            String      @id @default(cuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  modePeriode   String      @default("cyclePaie")
  debutSemaine  Int         @default(1)
  reportHebdo   Boolean     @default(false)
  animations    Boolean     @default(true)
  /// Règles des scénarios (JSON) ; vide = règles par défaut (lot 11).
  reglesScenarios String?
  /// Solde du compte courant au début de `moisDepart`, en centimes : départ du cumul (lot 13).
  soldeDepart   Int?
  moisDepart    String?
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt
}

// Lot 4 — salaire et cycle de paie (docs/lots.md, bilan du lot 4).
// Dates civiles en texte « AAAA-MM-JJ », mois en « AAAA-MM » : pas de fuseau sur une date de paie.

/// Une version du contrat : s'applique à partir de moisEffet, jusqu'à la version suivante.
model ContratSalaire {
  id                 String      @id @default(cuid())
  utilisateurId      String
  utilisateur        Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  moisEffet          String
  montantNet         Int
  jourHabituel       Int
  regleJourNonOuvre  String      @default("apres")
  financeMoisSuivant Boolean     @default(true)
  creeLe             DateTime    @default(now())
  modifieLe          DateTime    @updatedAt

  @@unique([utilisateurId, moisEffet])
}

/// Paie sur laquelle l'utilisateur a agi (primes prévues ou réception). Les autres sont calculées.
model Paie {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  moisFinance   String
  /// Renseignée à la réception (R28).
  dateReelle    String?
  /// Copie de la date prévue au moment de la réception (R27).
  datePrevue    String?
  recueLe       DateTime?
  lignes        LignePaie[]
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt

  @@unique([utilisateurId, moisFinance])
}

model LignePaie {
  id            String  @id @default(cuid())
  paieId        String
  paie          Paie    @relation(fields: [paieId], references: [id], onDelete: Cascade)
  utilisateurId String
  type          String
  libelle       String
  certitude     String
  /// Vide pour une prime imprévue, ajoutée à la réception.
  montantPrevu  Int?
  /// Vide tant que la paie n'est pas reçue.
  montantRecu   Int?
  /// Prime d'une source de revenus versée avec la paie (lot 5).
  sourceId      String?
  ordre         Int     @default(0)

  @@index([utilisateurId])
}

// Lot 5 — autres revenus (docs/lots.md, bilan du lot 5).

/// Revenu hors salaire qui revient : prime, revenu variable, autre.
model SourceRevenu {
  id            String       @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  libelle       String
  type          String
  montant       Int
  frequence     String
  /// Mois choisis, ex. « 6,12 ».
  mois          String       @default("")
  versement     String
  jour          Int?
  certitude     String
  debut         String
  fin           String?
  recus         RevenuRecu[]
  creeLe        DateTime     @default(now())
  modifieLe     DateTime     @updatedAt

  @@index([utilisateurId])
}

/// Revenu réellement reçu hors paie (réel). Garde sa valeur si la source est supprimée.
model RevenuRecu {
  id             String        @id @default(cuid())
  utilisateurId  String
  utilisateur    Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  sourceId       String?
  source         SourceRevenu? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  moisOccurrence String?
  date           String
  montant        Int
  libelle        String
  note           String?
  creeLe         DateTime      @default(now())
  modifieLe      DateTime      @updatedAt

  @@unique([sourceId, moisOccurrence])
  @@index([utilisateurId, date])
}

// Lot 6 — charges, enveloppes, ponctuels, dettes (docs/lots.md, bilan du lot 6).

model Categorie {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  libelle       String
  /// essentiel | flexible | engagement
  groupe        String
  icone         String      @default("autre")
  ordre         Int         @default(0)
  charges       Charge[]
  ponctuels     Ponctuel[]
  depenses      Depense[]
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt

  @@unique([utilisateurId, libelle])
}

/// Charge fixe (datée) ou enveloppe (budget par mois budgétaire).
model Charge {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  categorieId   String
  categorie     Categorie   @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  libelle       String
  nature        String
  montant       Int
  frequence     String      @default("mensuelle")
  mois          String      @default("")
  jour          Int?
  debut         String
  fin           String?
  essentielle   Boolean     @default(false)
  /// Enveloppe : rythme de consommation du budget du mois, « mois », « semaine » ou « jour ».
  unite         String      @default("mois")
  /// Enveloppe par semaine ou par jour : montant ouvert chaque semaine ou chaque jour (centimes).
  rythme        Int?
  /// Enveloppe par semaine : montants choisis pour des semaines précises, « 2026-10-05:10000;… ».
  semaines      String      @default("")
  depenses      Depense[]
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt

  @@index([utilisateurId])
}

/// Charge unique connue et datée (assurance de décembre, permis).
model Ponctuel {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  categorieId   String
  categorie     Categorie   @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  libelle       String
  montant       Int
  date          String
  certitude     String      @default("garanti")
  depenses      Depense[]
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt

  @@index([utilisateurId, date])
}

/// Dette : un total et un échéancier calculé (mensualité à partir de la première échéance).
model Dette {
  id               String          @id @default(cuid())
  utilisateurId    String
  utilisateur      Utilisateur     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  libelle          String
  creancier        String          @default("")
  montantTotal     Int
  mensualite       Int
  premiereEcheance String
  note             String?
  paiements        PaiementDette[]
  creeLe           DateTime        @default(now())
  modifieLe        DateTime        @updatedAt

  @@index([utilisateurId])
}

/// Paiement réel d'une dette.
model PaiementDette {
  id            String   @id @default(cuid())
  detteId       String
  dette         Dette    @relation(fields: [detteId], references: [id], onDelete: Cascade)
  utilisateurId String
  date          String
  montant       Int
  note          String?
  creeLe        DateTime @default(now())

  @@index([utilisateurId])
}

/// Dépense réelle. Liée à une charge fixe (avec l'échéance couverte), une enveloppe, un ponctuel, ou hors plan.
/// Si la ligne du plan est supprimée, la dépense reste (elle a eu lieu) et passe hors plan.
model Depense {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  date          String
  montant       Int
  categorieId   String
  categorie     Categorie   @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  libelle       String      @default("")
  note          String?
  chargeId      String?
  charge        Charge?     @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  /// Date prévue de l'échéance couverte (charge fixe).
  echeance      String?
  ponctuelId    String?
  ponctuel      Ponctuel?   @relation(fields: [ponctuelId], references: [id], onDelete: SetNull)
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt

  @@index([utilisateurId, date])
}

/// Mois budgétaire clôturé (R21) : bornes et bilan figés. Il ne bouge plus tant qu'il n'est pas rouvert.
model ClotureMois {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  cle           String
  debut         String
  fin           String
  /// Bilan figé (JSON) : lignes, totaux, rythme.
  instantane    String
  /// Semaines figées (JSON), avec le début de semaine et le report de la clôture. Absent avant le lot 9.
  semaines      String?
  forcee        Boolean     @default(false)
  nonConfirmees Int         @default(0)
  clotureLe     DateTime    @default(now())

  @@unique([utilisateurId, cle])
}

/// Trace des clôtures et réouvertures (R22).
model JournalCloture {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  cle           String
  /// cloture | reouverture
  action        String
  nonConfirmees Int         @default(0)
  le            DateTime    @default(now())

  @@index([utilisateurId, cle])
}

/// Compte d'épargne : solde déclaré (réel) à une date (R12).
model CompteEpargne {
  id            String             @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur        @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  libelle       String
  solde         Int
  auLe          String
  mouvements    MouvementEpargne[]
  creeLe        DateTime           @default(now())
  modifieLe     DateTime           @updatedAt
}

/// Versement (+), retrait (−) ou achat (objectif réalisé, R19) : réel, jamais une dépense (R11).
model MouvementEpargne {
  id            String        @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  compteId      String
  compte        CompteEpargne @relation(fields: [compteId], references: [id], onDelete: Restrict)
  objectifId    String?
  objectif      Objectif?     @relation(fields: [objectifId], references: [id], onDelete: SetNull)
  type          String
  date          String
  montant       Int
  libelle       String        @default("")
  note          String?
  creeLe        DateTime      @default(now())

  @@index([utilisateurId, date])
}

/// Objectif d'épargne (R16) ; « atteint » se calcule, il n'est pas stocké.
model Objectif {
  id               String             @id @default(cuid())
  utilisateurId    String
  utilisateur      Utilisateur        @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  libelle          String
  type             String             @default("autre")
  montantCible     Int
  montantInitial   Int                @default(0)
  dateCible        String?
  priorite         Int
  versementMensuel Int?
  statut           String             @default("actif")
  realiseLe        String?
  creeLe           DateTime           @default(now())
  modifieLe        DateTime           @updatedAt
  mouvements       MouvementEpargne[]
}

/// Scénario de simulation enregistré : des leviers, jamais des données (lot 11).
model Scenario {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nom           String
  ajustements   String
  horizon       Int         @default(12)
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt
}

/// Fichier importé à l'onboarding (lot 19) : le fichier brut est archivé, l'analyse garde la décision de chaque ligne.
model ImportSource {
  id            String      @id @default(cuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  /// `moneyGuruV0`.
  type          String
  fichierBrut   String
  /// JSON : lignes proposées (avec leur statut), éléments non importés, profil.
  analyse       String
  importeLe     DateTime    @default(now())
}

/// Session ouverte avec le mot de passe d'un compte (lot 22). `id` = empreinte SHA-256 du jeton du cookie : le jeton n'est jamais stocké.
model Session {
  id            String      @id
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now())
  expireLe      DateTime

  @@index([utilisateurId])
}

/// Lien de réinitialisation (ou d'activation) du mot de passe (lot 23). `id` = empreinte SHA-256 du jeton envoyé : usage unique, durée limitée.
model JetonMotDePasse {
  id            String      @id
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now())
  expireLe      DateTime

  @@index([utilisateurId])
}

/// Lien envoyé à une adresse e-mail (lot 24) : `verification` confirme l'adresse du compte, `changement` la remplace par `email` une fois ouvert.
/// `id` = empreinte SHA-256 du jeton envoyé : usage unique, durée limitée.
model JetonEmail {
  id            String      @id
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type          String
  email         String
  creeLe        DateTime    @default(now())
  expireLe      DateTime

  @@index([utilisateurId])
}
