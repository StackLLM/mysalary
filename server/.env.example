# development (par défaut) ou production. En production, le serveur refuse de démarrer
# sans SMTP_URL, sans APP_URL en https:// ou avec COOKIE_SECURE=0 (docs/prod.md § 8.1).
# NODE_ENV=production

# Fichier SQLite, relatif au dossier prisma/
DATABASE_URL="file:./mysalary.db"
PORT=3010

# Adresse d'écoute : 127.0.0.1 (par défaut, local). Pour un accès réseau : 0.0.0.0, derrière un proxy HTTPS.
# HOTE=127.0.0.1

# Adresse de l'interface, utilisée dans les liens envoyés par e-mail (mot de passe oublié, activation).
# En https://…, le cookie de session devient « Secure ».
APP_URL=http://127.0.0.1:6010

# Forcer (1) ou non (0) le cookie « Secure » ; par défaut : selon APP_URL.
# COOKIE_SECURE=1

# Derrière un proxy (Nginx, Caddy…) : 1 pour lire l'adresse du client dans X-Forwarded-For (limitation des essais).
# TRUST_PROXY=1

# Envoi des e-mails (confirmation d'adresse, changement d'e-mail, mot de passe oublié).
# Sans SMTP_URL, les liens sont écrits dans le journal du serveur (usage local). Mise en place : docs/prod.md § 8.4.
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.com:465
# MAIL_FROM="MySalary <no-reply@exemple.com>"
